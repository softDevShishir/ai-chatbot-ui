# Copy to .env.local only if you need to change something. No secrets belong here:
# every VITE_* value used in src/ is compiled into the public JavaScript bundle.

# Where the Vite dev server forwards /api requests (development only, not bundled).
VITE_API_PROXY_TARGET=http://localhost:8080

# Backend origin for a separately hosted (deployed) frontend, e.g. https://api.example.com
# Leave empty in development: the dev proxy above handles /api. If you set it, add this UI's
# origin to CORS_ALLOWED_ORIGINS on the backend.
VITE_API_BASE_URL=
